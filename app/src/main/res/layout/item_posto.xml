<?xml version="1.0" encoding="utf-8"?>
<!-- C1: item da lista de postos. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardPosto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/margem_padrao"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/margem_padrao">

        <ImageView
            android:id="@+id/imgPosto"
            android:layout_width="@dimen/icone_item"
            android:layout_height="@dimen/icone_item"
            android:background="@drawable/bg_icone_circular"
            android:contentDescription="@string/cd_icone_posto"
            android:padding="8dp"
            android:src="@drawable/ic_fabrica"
            app:tint="@color/azul_industrial" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margem_padrao"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNomePosto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="Montagem 3" />

            <TextView
                android:id="@+id/txtQtdInsumos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:drawablePadding="@dimen/margem_minima"
                android:gravity="center_vertical"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:drawableStartCompat="@drawable/ic_caixa"
                app:drawableTint="?attr/colorOnSurfaceVariant"
                tools:text="2 insumos" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
