<?xml version="1.0" encoding="utf-8"?>
<!-- C5 / C6: cartão na lista do operador. O botão de confirmar só aparece quando status == entregue. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCartao"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/margem_padrao"
    android:layout_marginVertical="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Barra lateral colorida pela urgência -->
        <View
            android:id="@+id/barraUrgencia"
            android:layout_width="@dimen/barra_urgencia_largura"
            android:layout_height="match_parent"
            android:background="@drawable/barra_urgencia_normal"
            android:contentDescription="@string/cd_urgencia" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="@dimen/margem_padrao">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtInsumo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Parafuso sextavado M8" />

                <TextView
                    android:id="@+id/txtTempo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margem_pequena"
                    android:drawablePadding="@dimen/margem_minima"
                    android:gravity="center_vertical"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/texto_corpo"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_relogio"
                    app:drawableTint="?attr/colorOnSurfaceVariant"
                    tools:text="há 12 min" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margem_pequena"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipUrgencia"
                    style="@style/Widget.Kanban.Chip"
                    tools:text="Crítica" />

                <TextView
                    android:id="@+id/chipStatus"
                    style="@style/Widget.Kanban.Chip"
                    android:layout_marginStart="@dimen/margem_pequena"
                    android:background="@drawable/bg_chip_status_aberto"
                    android:textColor="@color/preto_texto"
                    tools:text="Entregue" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmar"
                style="@style/Widget.Kanban.Botao.Confirmar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margem_padrao"
                android:text="@string/btn_confirmar_recebimento"
                android:visibility="gone"
                app:icon="@drawable/ic_check"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
